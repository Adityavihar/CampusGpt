# CampusGPT Environment Configuration Template
# Duplicate this file to .env and insert your valid credentials

# Jina AI Embeddings (API key for jina-embeddings-v3)
JINA_API_KEY=your_jina_api_key_here

# Groq LLM API (API key for Groq Cloud)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Flask Security
SECRET_KEY=generate_a_random_secure_hex_key_here
PORT=5000
FLASK_DEBUG=false

# Admin Knowledge Manager
ADMIN_PASSWORD=Aditya672@
ADMIN_API_KEY=optional_api_key_for_tools

# OCR and Poppler Configuration (Optional overrides)
# Windows defaults:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# POPPLER_PATH=C:\poppler\poppler-26.09.0\Library\bin
# Linux / Docker defaults:
# TESSERACT_CMD=tesseract
# POPPLER_PATH=
OCR_LANG=eng
